views:
  - type: table
    name: events
    filters:
      and:
        - file.hasTag("guild-event")
        - or:
            - file.hasTag("guild/reviewers")
            - file.hasTag("guild/common")
    order:
      - file.name
      - tags
      - date_created
      - date_modified
    sort:
      - property: file.name
        direction: ASC
